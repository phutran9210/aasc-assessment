# syntax=docker/dockerfile:1

# TikTok – Bitrix24 integration: one image for the API, the worker, migrations and tools.
# Build:  docker build -f Dockerfile.tiktok -t aasc-tiktok:local .

# The base image is pinned by tag and digest so a rebuild cannot silently pick up another Node.
# Update both together (or let Renovate/Dependabot do it).
ARG NODE_IMAGE=node:24.21.0-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20
# Version pinned to package.json "packageManager".
ARG PNPM_VERSION=11.2.2

# ── Base: Node + pnpm, dependency manifests only ─────────────────────────────────────────
FROM ${NODE_IMAGE} AS base
ARG PNPM_VERSION
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    CI=true
RUN npm install --global --no-fund --no-audit "pnpm@${PNPM_VERSION}"
WORKDIR /app
# Manifests only: the dependency layers below are rebuilt only when these files change.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# ── Build: all dependencies, compile the TikTok app to dist-tiktok/ ─────────────────────
FROM base AS build
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile
COPY nest-cli.tiktok.json tsconfig.json tsconfig.tiktok.build.json ./
COPY src ./src
RUN pnpm build:tiktok

# ── Production dependencies only ─────────────────────────────────────────────────────────
FROM base AS prod-deps
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --prod --frozen-lockfile

# ── Runtime: non-root, no build tools, no package manager ────────────────────────────────
FROM ${NODE_IMAGE} AS runtime
ENV NODE_ENV=production \
    TIKTOK_APP_PORT=3001 \
    INTEGRATION_ARTIFACT_DIR=/app/data/tiktok-artifacts
WORKDIR /app

# The runtime only ever runs `node`: without a package manager in the image there is nothing to
# install or download with from inside a compromised container.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-* \
      /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
      /usr/local/bin/yarn /usr/local/bin/yarnpkg

COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build /app/dist-tiktok ./dist-tiktok
COPY package.json ./
COPY samples/tiktok ./samples/tiktok

# Export artifacts and import uploads live here; API and worker must share this volume. It is the
# only path the app writes to: the code stays owned by root and the root filesystem may be mounted
# read-only.
RUN mkdir -p data/tiktok-artifacts artifacts && chown -R 1000:1000 /app/data /app/artifacts

# Passed by CI or `docker build --build-arg`, so a running container can be traced to its commit.
ARG VERSION=local
ARG REVISION=unknown
LABEL org.opencontainers.image.title="aasc-tiktok" \
      org.opencontainers.image.description="TikTok Lead Generation to Bitrix24 CRM integration (API, worker, migrations)" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"

# The `node` user by number, so orchestrators can verify the container does not run as root.
USER 1000:1000
VOLUME ["/app/data/tiktok-artifacts"]
EXPOSE 3001
STOPSIGNAL SIGTERM

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.TIKTOK_APP_PORT || 3001) + '/health/live').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"

CMD ["node", "dist-tiktok/apps/tiktok/main.js"]
