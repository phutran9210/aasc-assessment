# TikTok – Bitrix24 integration. Copy to .env.tiktok and edit; never commit the copy.
# Every value below is a local demo placeholder. Replace all secrets before any shared use.

# ── Application ──
TIKTOK_APP_PORT=3001
# "*" or a comma separated list of allowed origins.
CORS_ORIGINS=*
# OpenAPI UI at /docs. Defaults to on outside production and off in production.
# TIKTOK_SWAGGER_ENABLED=true
# Reverse proxies whose X-Forwarded-For header may be believed (comma separated IPs). Empty: none.
TIKTOK_TRUSTED_PROXIES=
# Requests per minute: per client address on public endpoints, and verified webhooks per advertiser.
# TIKTOK_INGRESS_IP_LIMIT=600
# TIKTOK_WEBHOOK_ADVERTISER_LIMIT=120

# ── PostgreSQL (dedicated database; never the AASC SQLite file) ──
# Used by docker-compose.tiktok.yml to create the database and to build TIKTOK_DATABASE_URL.
TIKTOK_POSTGRES_USER=tiktok
TIKTOK_POSTGRES_PASSWORD=change-me-local-postgres-password
TIKTOK_POSTGRES_DB=tiktok
# Outside Compose, set the full URL yourself:
TIKTOK_DATABASE_URL=postgres://tiktok:change-me-local-postgres-password@127.0.0.1:5432/tiktok
# TIKTOK_DATABASE_SCHEMA=public

# ── Redis (sessions, queues, rate limits, cache) ──
TIKTOK_REDIS_URL=redis://127.0.0.1:6379
INTEGRATION_QUEUE_PREFIX=aasc-tiktok

# ── Authentication of the management API ──
# At least 32 characters; generate one with: openssl rand -base64 48
TIKTOK_JWT_SECRET=change-me-demo-jwt-secret-of-at-least-32-chars
TIKTOK_JWT_ISSUER=aasc-tiktok
TIKTOK_JWT_AUDIENCE=aasc-tiktok-clients
TIKTOK_JWT_TTL_SECONDS=900

# ── Deployment identity: one advertiser, one portal, one provider mode per database ──
# The first start records these four values; a later start with different ones is refused.
TIKTOK_MODE=mock
BITRIX_INTEGRATION_MODE=mock
TIKTOK_ADVERTISER_ID=mock-advertiser
BITRIX_PORTAL_KEY=mock-portal

# ── TikTok webhook ──
# Shared secret of the signed webhook (HMAC-SHA256 over "<timestamp>.<raw body>").
TIKTOK_WEBHOOK_SECRET=change-me-demo-webhook-secret
# TIKTOK_EVENT_SOURCE_ID=

# ── Bitrix24 ──
# Mock mode: REST endpoint of the local mock server.
BITRIX24_WEBHOOK_URL=http://127.0.0.1:3002/rest/1/mock/
# Secret of mock deal callbacks (header X-Mock-Bitrix-Secret); ignored in real mode.
BITRIX_MOCK_EVENT_SECRET=change-me-demo-bitrix-event-secret
# Real mode only: token Bitrix24 sends with outgoing webhooks, and OAuth application settings.
# BITRIX24_OUTGOING_TOKEN=
# BITRIX24_CLIENT_ID=
# BITRIX24_CLIENT_SECRET=
# BITRIX24_DOMAIN=
# BITRIX24_REQUISITE_PRESET_ID=

# ── Mock providers (local demo only) ──
TIKTOK_MOCK_BASE_URL=http://127.0.0.1:3002/tiktok
TIKTOK_MOCK_API_KEY=local-only-mock-key
TIKTOK_MOCK_PORT=3002

# ── Processing ──
DEFAULT_PHONE_REGION=VN
REPORT_TIMEZONE=Asia/Ho_Chi_Minh
# true on the API when a worker is deployed: readiness then requires a fresh worker heartbeat.
INTEGRATION_WORKER_ENABLED=false
# true on exactly the workers that should run schedules (reports, alerts, score, retention).
INTEGRATION_SCHEDULER_ENABLED=false
# Export files and import uploads; outside public/, shared by API and worker.
INTEGRATION_ARTIFACT_DIR=data/tiktok-artifacts

# ── Demo tools (pnpm tiktok:demo, tiktok:webhook, tiktok:load-probe) ──
TIKTOK_DEMO_BASE_URL=http://127.0.0.1:3001
# TIKTOK_DEMO_USERNAME=demo-admin
# TIKTOK_DEMO_PASSWORD=demo-password-change-me
