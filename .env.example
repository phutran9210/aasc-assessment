# ── App ──
NODE_ENV=development
PORT=3000
# "*" cho phép mọi origin; hoặc danh sách cách nhau bởi dấu phẩy: https://a.com,https://b.com
CORS_ORIGINS=*
# Bật Swagger UI tại /docs (nên tắt ở production).
SWAGGER_ENABLED=true

# ── Database (SQLite) ──
# Đường dẫn file SQLite, thư mục cha được tạo tự động. Dùng ":memory:" cho test.
DATABASE_PATH=data/app.sqlite
# Tự đồng bộ schema từ entity (chỉ nên bật ở local/dev).
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=false

# ── Auth ──
# Khóa ký JWT, tối thiểu 16 ký tự. BẮT BUỘC đổi khi NODE_ENV=production.
JWT_SECRET=dev-only-jwt-secret-change-me
# Thời hạn access token (giây). 86400 = 1 ngày.
JWT_EXPIRES_IN_SECONDS=86400
# Độ khó bcrypt (4-15). Mỗi +1 làm thời gian băm tăng gấp đôi.
BCRYPT_ROUNDS=10

# ── Bitrix24 OAuth (optional until the integration is configured) ──
BITRIX24_CLIENT_ID=
BITRIX24_CLIENT_SECRET=
# Hostname only, for example: your-portal.bitrix24.com
BITRIX24_DOMAIN=
# Get a valid preset ID with crm.requisite.preset.list
BITRIX24_REQUISITE_PRESET_ID=

# ── Jotform (optional until the integration is configured) ──
# Jotform → Settings → API → Create New Key (quyền Read Access là đủ)
JOTFORM_API_KEY=
# Dãy số cuối URL biểu mẫu: https://form.jotform.com/<FORM_ID>
JOTFORM_FORM_ID=
# Chuỗi bí mật tự đặt, tối thiểu 16 ký tự; gắn vào URL webhook dạng ?secret=...
JOTFORM_WEBHOOK_SECRET=
# Tài khoản vùng EU dùng https://eu-api.jotform.com
JOTFORM_API_BASE_URL=https://api.jotform.com

# ── Bitrix24 webhook (thay cho OAuth khi chạy đồng bộ lead) ──
# Bitrix24 → Developer resources → Other → Inbound webhook, quyền crm và user.
# URL này là secret. Có giá trị thì mọi lời gọi Bitrix24 dùng webhook thay cho OAuth.
BITRIX24_WEBHOOK_URL=

# ── Google Sheets (optional until the lead sync is configured) ──
# service_account (mặc định) hoặc oauth (giai đoạn 2).
GOOGLE_AUTH_MODE=service_account
# Đường dẫn file khóa JSON của service account; thư mục secrets/ không được commit.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=secrets/google-sa.json
# Hoặc nội dung file khóa mã hóa base64 (base64 -w0 secrets/google-sa.json); ưu tiên hơn file.
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Nơi lưu refresh token sau khi cấp quyền OAuth (là bí mật, không commit)
GOOGLE_OAUTH_TOKEN_FILE=secrets/google-oauth-token.json
# Chuỗi giữa /d/ và /edit trong URL của Sheet. Sheet phải share quyền Editor cho service account.
GOOGLE_SHEET_ID=
# Tên worksheet (tab).
GOOGLE_SHEET_NAME=Leads

# ── Lead sync: Google Sheets → Bitrix24 ──
LEAD_SYNC_MAPPING_PATH=config/mapping.json
# Biểu thức cron, ví dụ */15 * * * * (mỗi 15 phút). Để trống là tắt lịch.
LEAD_SYNC_CRON=
LEAD_SYNC_TIMEZONE=Asia/Ho_Chi_Minh
# sheet-to-bitrix (mặc định) hoặc two-way: two-way ghi thêm giai đoạn và người phụ trách từ
# Bitrix24 về Sheet khi lead thay đổi.
LEAD_SYNC_DIRECTION=sheet-to-bitrix
# Địa chỉ công khai của ứng dụng (ví dụ URL ngrok); Bitrix24 gửi sự kiện lead về
# <APP_PUBLIC_URL>/lead-sync/bitrix-events. Chỉ cần khi dùng two-way.
APP_PUBLIC_URL=
# application_token của outgoing webhook tạo tay trong portal (sự kiện ONCRMLEADUPDATE, handler
# <APP_PUBLIC_URL>/lead-sync/bitrix-events). Cần khi ứng dụng không được cài qua OAuth; nếu đã
# cài thì sự kiện của ứng dụng vẫn được chấp nhận song song.
BITRIX24_OUTGOING_TOKEN=
# Mock-only credential for POST /webhooks/bitrix24/deals (minimum 16 characters).
BITRIX_MOCK_EVENT_SECRET=
# Quốc gia mặc định khi chuẩn hóa số điện thoại: VN, US hoặc SG.
LEAD_SYNC_DEFAULT_COUNTRY=VN
# Số lần thử lại một lần gọi API khi gặp rate limit, timeout hoặc 5xx (0-10).
LEAD_SYNC_MAX_RETRIES=4
# Số ngày giữ nhật ký lần chạy trong SQLite.
LEAD_SYNC_LOG_RETENTION_DAYS=30
