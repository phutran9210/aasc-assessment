# One configuration file for both applications in this repository. Copy to .env and edit; never
# commit the copy. `.env` and `.env.example` hold the same variables in the same order.
#
#   Part 1  AASC assessment app (port 3000, SQLite)        docker-compose.yml
#   Part 2  TikTok – Bitrix24 integration (port 3001)      docker-compose.tiktok.yml
#
# Shared by both parts: NODE_ENV, CORS_ORIGINS and the Bitrix24 OAuth application settings
# (BITRIX24_CLIENT_ID, BITRIX24_CLIENT_SECRET, BITRIX24_DOMAIN, BITRIX24_REQUISITE_PRESET_ID).
# Everything else belongs to one part only. In particular the TikTok app never reads
# BITRIX24_WEBHOOK_URL or BITRIX24_OUTGOING_TOKEN: it has its own TIKTOK_BITRIX24_* pair, so a
# demo against the mock cannot reach the portal of Part 1 by accident.

# ════════════════════════════════════════════════════════════════════════════════════════
# Part 1 — AASC assessment app
# ════════════════════════════════════════════════════════════════════════════════════════

# ── App ──
NODE_ENV=development
PORT=3000
# "*" cho phép mọi origin; hoặc danh sách cách nhau bởi dấu phẩy: https://a.com,https://b.com
CORS_ORIGINS=*
# Bật Swagger UI tại /docs (nên tắt ở production).
SWAGGER_ENABLED=true

# ── Database (SQLite) ──
# Đường dẫn file SQLite, thư mục cha được tạo tự động. Dùng ":memory:" cho test.
DATABASE_PATH=data/app.sqlite
# Tự đồng bộ schema từ entity (chỉ nên bật ở local/dev).
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=false

# ── Auth ──
# Khóa ký JWT, tối thiểu 16 ký tự. BẮT BUỘC đổi khi NODE_ENV=production.
JWT_SECRET=dev-only-jwt-secret-change-me
# Thời hạn access token (giây). 86400 = 1 ngày.
JWT_EXPIRES_IN_SECONDS=86400
# Độ khó bcrypt (4-15). Mỗi +1 làm thời gian băm tăng gấp đôi.
BCRYPT_ROUNDS=10

# ── Bitrix24 OAuth (optional until the integration is configured) ──
BITRIX24_CLIENT_ID=
BITRIX24_CLIENT_SECRET=
# Hostname only, for example: your-portal.bitrix24.com
# Required to install the app through OAuth: POST /install answers 503 while this is empty, and
# only this portal may install.
BITRIX24_DOMAIN=
# Get a valid preset ID with crm.requisite.preset.list
BITRIX24_REQUISITE_PRESET_ID=

# ── Jotform (optional until the integration is configured) ──
# Jotform → Settings → API → Create New Key (quyền Read Access là đủ)
JOTFORM_API_KEY=
# Dãy số cuối URL biểu mẫu: https://form.jotform.com/<FORM_ID>
JOTFORM_FORM_ID=
# Chuỗi bí mật tự đặt, tối thiểu 16 ký tự; gắn vào URL webhook dạng ?secret=...
JOTFORM_WEBHOOK_SECRET=
# Tài khoản vùng EU dùng https://eu-api.jotform.com
JOTFORM_API_BASE_URL=https://api.jotform.com

# ── Bitrix24 webhook (thay cho OAuth khi chạy đồng bộ lead) ──
# Bitrix24 → Developer resources → Other → Inbound webhook, quyền crm và user.
# URL này là secret. Có giá trị thì mọi lời gọi Bitrix24 dùng webhook thay cho OAuth.
BITRIX24_WEBHOOK_URL=

# ── Google Sheets (optional until the lead sync is configured) ──
# service_account (mặc định) hoặc oauth (giai đoạn 2).
GOOGLE_AUTH_MODE=service_account
# Đường dẫn file khóa JSON của service account; thư mục secrets/ không được commit.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=secrets/google-sa.json
# Hoặc nội dung file khóa mã hóa base64 (base64 -w0 secrets/google-sa.json); ưu tiên hơn file.
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Nơi lưu refresh token sau khi cấp quyền OAuth (là bí mật, không commit)
GOOGLE_OAUTH_TOKEN_FILE=secrets/google-oauth-token.json
# Chuỗi giữa /d/ và /edit trong URL của Sheet. Sheet phải share quyền Editor cho service account.
GOOGLE_SHEET_ID=
# Tên worksheet (tab).
GOOGLE_SHEET_NAME=Leads

# ── Lead sync: Google Sheets → Bitrix24 ──
LEAD_SYNC_MAPPING_PATH=config/mapping.json
# Biểu thức cron, ví dụ */15 * * * * (mỗi 15 phút). Để trống là tắt lịch.
LEAD_SYNC_CRON=
LEAD_SYNC_TIMEZONE=Asia/Ho_Chi_Minh
# sheet-to-bitrix (mặc định) hoặc two-way: two-way ghi thêm giai đoạn và người phụ trách từ
# Bitrix24 về Sheet khi lead thay đổi.
LEAD_SYNC_DIRECTION=sheet-to-bitrix
# Địa chỉ công khai của ứng dụng (ví dụ URL ngrok); Bitrix24 gửi sự kiện lead về
# <APP_PUBLIC_URL>/lead-sync/bitrix-events. Chỉ cần khi dùng two-way.
APP_PUBLIC_URL=
# application_token của outgoing webhook tạo tay trong portal (sự kiện ONCRMLEADUPDATE, handler
# <APP_PUBLIC_URL>/lead-sync/bitrix-events). Cần khi ứng dụng không được cài qua OAuth; nếu đã
# cài thì sự kiện của ứng dụng vẫn được chấp nhận song song.
BITRIX24_OUTGOING_TOKEN=
# Quốc gia mặc định khi chuẩn hóa số điện thoại: VN, US hoặc SG.
LEAD_SYNC_DEFAULT_COUNTRY=VN
# Số lần thử lại một lần gọi API khi gặp rate limit, timeout hoặc 5xx (0-10).
LEAD_SYNC_MAX_RETRIES=4
# Số ngày giữ nhật ký lần chạy trong SQLite.
LEAD_SYNC_LOG_RETENTION_DAYS=30

# ════════════════════════════════════════════════════════════════════════════════════════
# Part 2 — TikTok – Bitrix24 integration
# ════════════════════════════════════════════════════════════════════════════════════════

# ── Mode (docker-compose.tiktok.yml) ──
# Which services start. app = PostgreSQL, Redis, migrations, API, worker; mock = the mock
# providers; demo = the demo seed.
#   Demo, everything mocked ............ app,mock,demo   with BITRIX_INTEGRATION_MODE=mock
#   Real Bitrix24 portal, TikTok mocked  app,mock        with BITRIX_INTEGRATION_MODE=real
#   Production .......................... app             with NODE_ENV=production
# One database serves one mode: before switching, remove the stack with `down -v` or give the
# new mode its own TIKTOK_COMPOSE_PROJECT.
COMPOSE_PROFILES=app,mock,demo
# Compose project name (containers and volumes are prefixed with it).
# TIKTOK_COMPOSE_PROJECT=aasc-tiktok
# Image to run; set it to one built and scanned by CI instead of building on the host.
# TIKTOK_IMAGE=aasc-tiktok:local
# Memory limits of the containers.
# TIKTOK_API_MEMORY=512m
# TIKTOK_WORKER_MEMORY=768m
# TIKTOK_POSTGRES_MEMORY=1g

# ── Application ──
# Port published on 127.0.0.1.
TIKTOK_APP_PORT=3001
# OpenAPI UI at /docs. Defaults to on outside production and off in production.
# TIKTOK_SWAGGER_ENABLED=true
# Reverse proxies whose X-Forwarded-For header may be believed (comma separated IPs). Empty: none.
TIKTOK_TRUSTED_PROXIES=
# Requests per minute: per client address on public endpoints, and verified webhooks per advertiser.
# TIKTOK_INGRESS_IP_LIMIT=600
# TIKTOK_WEBHOOK_ADVERTISER_LIMIT=120

# ── PostgreSQL (dedicated database; never the SQLite file of Part 1) ──
# Used by docker-compose.tiktok.yml to create the database and to build TIKTOK_DATABASE_URL
# inside the containers.
TIKTOK_POSTGRES_USER=tiktok
TIKTOK_POSTGRES_PASSWORD=change-me-local-postgres-password
TIKTOK_POSTGRES_DB=tiktok
# Outside Compose, set the full URL yourself:
TIKTOK_DATABASE_URL=postgres://tiktok:change-me-local-postgres-password@127.0.0.1:5432/tiktok
# TIKTOK_DATABASE_SCHEMA=public

# ── Redis (sessions, queues, rate limits, cache) ──
# Outside Compose:
TIKTOK_REDIS_URL=redis://127.0.0.1:6379
# Password of the Compose Redis; set one in production. Letters and digits only: it is placed
# inside a URL.
TIKTOK_REDIS_PASSWORD=
INTEGRATION_QUEUE_PREFIX=aasc-tiktok

# ── Authentication of the management API ──
# At least 32 characters; generate one with: openssl rand -base64 48
TIKTOK_JWT_SECRET=change-me-demo-jwt-secret-of-at-least-32-chars
TIKTOK_JWT_ISSUER=aasc-tiktok
TIKTOK_JWT_AUDIENCE=aasc-tiktok-clients
TIKTOK_JWT_TTL_SECONDS=900

# ── Deployment identity: one advertiser, one portal, one provider mode per database ──
# The first start records these four values; a later start with different ones is refused.
# The TikTok mode `business-api` is not enabled yet.
TIKTOK_MODE=mock
BITRIX_INTEGRATION_MODE=mock
TIKTOK_ADVERTISER_ID=mock-advertiser
BITRIX_PORTAL_KEY=mock-portal

# ── TikTok webhook ──
# Shared secret of the signed webhook (HMAC-SHA256 over "<timestamp>.<raw body>"), 16+ characters.
TIKTOK_WEBHOOK_SECRET=change-me-demo-webhook-secret
# TIKTOK_EVENT_SOURCE_ID=

# ── Bitrix24 as the TikTok app sees it ──
# REST endpoint of the CRM. Mock mode: the mock server, by its Compose service name (without
# Docker use http://127.0.0.1:3002/rest/1/mock/). Real mode: the incoming webhook of the portal
# with the crm scope, for example the value of BITRIX24_WEBHOOK_URL in Part 1.
TIKTOK_BITRIX24_WEBHOOK_URL=http://mock:3002/rest/1/mock/
# Real mode only: application token of the portal's outgoing webhook for deal events
# (ONCRMDEALADD/UPDATE/DELETE to <this app>/webhooks/bitrix24/deals), 16+ characters.
TIKTOK_BITRIX24_OUTGOING_TOKEN=
# Mock mode only: secret of mock deal callbacks (header X-Mock-Bitrix-Secret), 16+ characters.
BITRIX_MOCK_EVENT_SECRET=change-me-demo-bitrix-event-secret

# ── Mock providers (never next to real credentials for the mocked side) ──
# Without Docker use http://127.0.0.1:3002/tiktok
TIKTOK_MOCK_BASE_URL=http://mock:3002/tiktok
TIKTOK_MOCK_API_KEY=local-only-mock-key
TIKTOK_MOCK_PORT=3002

# ── Processing ──
DEFAULT_PHONE_REGION=VN
REPORT_TIMEZONE=Asia/Ho_Chi_Minh
# Only without Docker (Compose sets both): true on the API when a worker is deployed, and true on
# exactly the workers that should run schedules.
INTEGRATION_WORKER_ENABLED=false
INTEGRATION_SCHEDULER_ENABLED=false
# Export files and import uploads; outside public/, shared by API and worker.
INTEGRATION_ARTIFACT_DIR=data/tiktok-artifacts

# ── Demo tools (pnpm tiktok:demo, tiktok:webhook, tiktok:load-probe) ──
TIKTOK_DEMO_BASE_URL=http://127.0.0.1:3001
# TIKTOK_DEMO_USERNAME=demo-admin
# TIKTOK_DEMO_PASSWORD=demo-password-change-me
