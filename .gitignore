# dependencies
node_modules/
docs/

# build output
dist/
coverage/
*.tsbuildinfo

# environment & local data (tokens, SQLite files) — never commit
.env
.env.*
!.env.example
data/
# The folder itself is tracked (.gitkeep) so that Docker does not create it owned by root.
secrets/*
!secrets/.gitkeep

# logs
logs/
*.log

# IDE / OS
.idea/
.vscode/
.DS_Store

# AI assistant tooling (local commands, plan workspaces)
.claude/
.superpowers/
